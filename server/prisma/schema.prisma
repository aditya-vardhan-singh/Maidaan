datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model UserProfile {
  id                       Int                       @id @default(autoincrement())
  profileType              ProfileType               @default(USER)
  email                    String                    @unique @db.VarChar(255)
  password                 String?                   @db.VarChar(60)
  name                     String?                   @db.VarChar(100)
  googleId                 String?                   @unique @db.VarChar(30)
  authType                 AuthType                  @default(LOCAL)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  eventParticipations      EventParticipation[]
  tournamentParticipations TournamentParticipation[]
  sportsParticipations     SportsParticipation[]
  organizedEvents          Event[]                   @relation("OrganizerEvents")
  organizedTournaments     Tournament[]              @relation("OrganizerTournaments")
  links                    Links[]                   @relation("UserProfileLinks")
}

enum ProfileType {
  ORGANIZER
  USER
}

enum AuthType {
  LOCAL
  GOOGLE
}

model TournamentParticipation {
  id             Int         @id @default(autoincrement())
  user           UserProfile @relation(fields: [userId], references: [id])
  userId         Int
  tournamentDate DateTime
  result         String      @db.VarChar(100)
  tournament     Tournament  @relation(fields: [tournamentId], references: [id])
  tournamentId   Int
  sport          Sports      @relation(fields: [sportId], references: [id])
  sportId        Int

  @@unique([userId, tournamentId])
}

model EventParticipation {
  id                Int         @id @default(autoincrement())
  user              UserProfile @relation(fields: [userId], references: [id])
  userId            Int
  event             Event       @relation(fields: [eventId], references: [id])
  eventId           Int
  participationDate DateTime
  result            String?     @db.VarChar(255)

  @@unique([userId, eventId])
}

model SportsParticipation {
  id         Int         @id @default(autoincrement())
  user       UserProfile @relation(fields: [userId], references: [id])
  userId     Int
  sport      Sports      @relation(fields: [sportId], references: [id])
  sportId    Int
  startDate  DateTime
  skillLevel String?     @db.VarChar(50)
  tournaments Tournament[]

  @@unique([userId, sportId])
}

model Sports {
  id                      Int                       @id @default(autoincrement())
  sportName               String                    @db.VarChar(100)
  sportType               SportType                 @default(SOLO)
  description             String?                   @db.VarChar(500)
  rules                   String?                   @db.Text
  equipmentRequired       String?                   @db.VarChar(255)
  events                  Event[]
  trainingCourses         TrainingCourse[]
  participants            SportsParticipation[]
  tournamentParticipation TournamentParticipation[]
  tournaments             Tournament[]
  sportAcademy            SportsAcademy[]
}

enum SportType {
  TEAM
  SOLO
}

model Event {
  id              Int                  @id @default(autoincrement())
  title           String               @db.VarChar(100)
  sport           Sports               @relation(fields: [sportId], references: [id])
  sportId         Int
  organizer       UserProfile          @relation("OrganizerEvents", fields: [organizerId], references: [id])
  organizerId     Int
  location        String               @db.VarChar(255)
  status          EventStatus          @default(ONGOING)
  registrationFee Float?               @default(0)
  eventDate       DateTime
  participants    EventParticipation[]
  links           Links[]              @relation("EventLinks")
}

enum EventStatus {
  ONGOING
  FINISHED
  UPCOMING
}

model Tournament {
  id                      Int                       @id @default(autoincrement())
  tournamentName          String                    @db.VarChar(200)
  sport                   Sports                    @relation(fields: [sportId], references: [id])
  sportId                 Int
  startDate               DateTime
  endDate                 DateTime
  schedule                Schedule[]
  prizes                  Prizes[]
  city                    String                    @db.VarChar(255)
  venueName               String                    @db.VarChar(255)
  registrationStatus      EventStatus               @default(ONGOING)
  tournamentDetails       String?                   @db.Text
  rules                   String?                   @db.Text
  registrationFee         Float?
  organizer               UserProfile?               @relation("OrganizerTournaments", fields: [organizerId], references: [id])
  organizerId             Int?
  TournamentParticipation TournamentParticipation[]
  links                   Links[]                   @relation("TournamentLinks")
  SportsParticipation     SportsParticipation?       @relation(fields: [sportsParticipationId], references: [id])
  sportsParticipationId   Int?
}

model Schedule {
  id           Int        @id @default(autoincrement())
  scheduleName String
  startDate    DateTime
  startTime    String
  endDate      DateTime
  endTime      String
  Tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId Int
}

model Prizes {
  id                       Int        @id @default(autoincrement())
  prizeName                String?
  trophy                   Boolean
  medal                    Boolean
  certificate              Boolean?
  participationCertificate Boolean?
  amount                   Float?
  tournamentId             Int
  Tournament               Tournament @relation(fields: [tournamentId], references: [id])
}

model TrainingCourse {
  id          Int           @id @default(autoincrement())
  courseName  String        @db.VarChar(200)
  sport       Sports        @relation(fields: [sportId], references: [id])
  sportId     Int
  description String?       @db.Text
  duration    String        @db.VarChar(100)
  fee         Decimal       @db.Decimal(10, 2)
  academy     SportsAcademy @relation(fields: [academyId], references: [id])
  academyId   Int
}

model SportsAcademy {
  id          Int              @id @default(autoincrement())
  academyName String           @db.VarChar(200)
  location    String           @db.VarChar(255)
  facilities  String?          @db.Text
  sports      Sports[]
  contactInfo String           @db.VarChar(255)
  email       String           @db.VarChar(255)
  courses     TrainingCourse[]
  links       Links[]          @relation("SportsAcademyLinks")
}

model Links {
  id              Int            @id @default(autoincrement())
  officialLink    String?
  xLink           String?
  instaLink       String?
  facebookLink    String?
  posterImage     String?
  userProfile     UserProfile?   @relation("UserProfileLinks", fields: [userProfileId], references: [id])
  userProfileId   Int?
  event           Event?         @relation("EventLinks", fields: [eventId], references: [id])
  eventId         Int?
  tournament      Tournament?    @relation("TournamentLinks", fields: [tournamentId], references: [id])
  tournamentId    Int?
  sportsAcademy   SportsAcademy? @relation("SportsAcademyLinks", fields: [sportsAcademyId], references: [id])
  sportsAcademyId Int?
}
